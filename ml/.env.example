# ------------------------------------------------------------------
# RailBuddy ML & Map Configuration
# Copy this file to `.env` and fill in your values.
# ------------------------------------------------------------------

# RailRadar API key (https://railradar.in).
RAILRADAR_API_KEY=rg_d58982c76bd54670a4240742b293e86f

# Base URL for upstream RailRadar API
RAILRADAR_BASE_URL=https://api.railradar.in/v1

# Local Express backend proxy URL (optional fallback)
RAILRADAR_PROXY_URL=http://localhost:4000

# Data Mode: REALTIME | HYBRID_REALTIME | DEMO | AUTO
DATA_MODE=AUTO

# Maximum requests per minute to upstream RailRadar
RAILRADAR_RATE_LIMIT_PER_MIN=120
