# ------------------------------------------------------------------
# RailBuddy backend environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` — it is git-ignored.
# ------------------------------------------------------------------

# RailRadar API key (https://railradar.in). Required for all RailRadar
# requests. Requests are sent as:  Authorization: Bearer <key>
RAILRADAR_API_KEY=

# Port the Express server listens on (frontend proxies /api/* here)
PORT=4000

# Simple in-memory rate limit: maximum requests per IP per 60s window
RAILRADAR_RATE_LIMIT_PER_MIN=120